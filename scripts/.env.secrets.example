# ─────────────────────────────────────────────────────────────────────────────
# .env.secrets.example — Template para ~/.env.secrets
#
# SETUP:
#   cp scripts/.env.secrets.example ~/.env.secrets
#   nano ~/.env.secrets      # completar con valores reales
#   chmod 600 ~/.env.secrets # solo vos podés leerlo
#
# ⚠  NUNCA renombres este archivo a .env.secrets acá — ese archivo
#    va al repo. Los valores reales van en ~/.env.secrets (fuera del repo).
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub Container Registry ─────────────────────────────────────────────────
# Crear en: https://github.com/settings/tokens → "read:packages"
GHCR_USER=MAtucR
GHCR_TOKEN=ghp_TU_TOKEN_ACA
GHCR_EMAIL=matuczito@gmail.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=moni
POSTGRES_PASSWORD=cambia_esta_password_segura
POSTGRES_DB=viajaconmoni

# ── Prisma / App ──────────────────────────────────────────────────────────────
# El hostname es el Service de k8s, no "localhost"
DATABASE_URL="postgresql://moni:cambia_esta_password_segura@postgres-service:5432/viajaconmoni?schema=public"

# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=genera_un_secreto_con_openssl_rand_base64_32
